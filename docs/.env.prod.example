#============#
# OpenAI     #
#============#
# IF using OpenAI
OPENAI_API_KEY=""

#============#
# Self-hosted#
# LLMs       #
#============#
# If models are hosted locally
API_KEY_SELF_HOSTED_MAIN=""
API_KEY_SELF_HOSTED_HELPER=""

#============#
# RAGFlow    #
#============#

RAGFLOW_API_KEY=""
RAGFLOW_BETA_TOKEN="" # Needed to provide doc references

#============#
# Google API #
#============#

# Required for Gemini models
GEMINI_API_KEY=""

# Web search: Google Agent Search (REQUIRED)
# Setup: AI Applications -> create a "Site search" app with a Website Content data store
# (advanced website indexing OFF if you don't own the domains), then create an API key
# restricted to https://discoveryengine.googleapis.com/*
# https://docs.cloud.google.com/generative-ai-app-builder/docs/migrate-from-cse
AGENT_SEARCH_API_KEY = "YOUR-KEY"
AGENT_SEARCH_PROJECT = "YOUR-PROJECT-ID-OR-NUMBER"
AGENT_SEARCH_ENGINE = "YOUR-APP-ID"
# Optional (defaults shown):
# AGENT_SEARCH_LOCATION = "global"   # non-global locations also need crawl_settings.search_base_url set to the regional endpoint
# AGENT_SEARCH_COLLECTION = "default_collection"
# AGENT_SEARCH_SERVING_CONFIG = "default_search"


#============#
# askUOS     #
#============#

# Generate secure random strings
# The STREAMLIT_API_KEY must match one of the keys in API_KEYS
API_KEYS = "<generate-secure-random-string>"
STREAMLIT_API_KEY = "<generate-secure-random-string>"

# used by fastapi — gates /v1/threads/* (read/delete chat history) only.
# Deliberately a disjoint secret from API_KEYS/STREAMLIT_API_KEY above: a
# completions-only key must not also be able to read or wipe someone's
# conversation history.
HISTORY_API_KEYS=""
STREAMLIT_HISTORY_API_KEY=""

# Embedding service must expose an openAI compatible API.
API_KEY_SELF_HOSTED_EMBEDDING=""